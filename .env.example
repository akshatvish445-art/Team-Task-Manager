NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tracker:tracker_dev_password@localhost:5432/team_tracker
# Generate a random secret of at least 32 characters before starting.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# Set true for a remotely hosted database requiring TLS with trusted certificates.
DATABASE_SSL=false
